function normalize(values, direction) {
  const valid = values.filter(v => v !== null && !isNaN(v));
  const min = Math.min(...valid);
  const max = Math.max(...valid);
  if (max === min) return values.map(v => (v === null ? null : 0.5));
  return values.map(v => {
    if (v === null || isNaN(v)) return null;
    const raw = (v - min) / (max - min);
    return direction === "lower_better" ? 1 - raw : raw;
  });
}

export default function BondScorer() {
  const [weights, setWeights] = useState(DEFAULT_WEIGHTS);
  const [sortBy, setSortBy] = useState("score");
  const [filterRating, setFilterRating] = useState("ALL");
  const [showTop, setShowTop] = useState(10);

  const totalWeight = Object.values(weights).reduce((a, b) => a + b, 0);

  const scored = useMemo(() => {
    const metrics = Object.keys(METRIC_INFO);
    const normalized = {};
    metrics.forEach(m => {
      normalized[m] = normalize(RAW_DATA.map(b => b[m]), METRIC_INFO[m].direction);
    });

    return RAW_DATA.map((bond, i) => {
      let score = 0;
      let usedWeight = 0;
      metrics.forEach(m => {
        const norm = normalized[m][i];
        if (norm !== null) {
          score += (weights[m] / 100) * norm * 100;
          usedWeight += weights[m];
        }
      });
      const adjustedScore = usedWeight > 0 ? (score / usedWeight) * 100 : 0;
      return { ...bond, score: adjustedScore, normalizedMetrics: metrics.reduce((acc, m) => ({ ...acc, [m]: normalized[m][i] }), {}) };
    });
  }, [weights]);

  const filtered = useMemo(() => {
    let data = filterRating === "ALL" ? scored : scored.filter(b => b.rating === filterRating);
    return [...data].sort((a, b) => {
      if (sortBy === "score") return b.score - a.score;
      if (sortBy === "gSpread") return b.gSpread - a.gSpread;
      if (sortBy === "defaultProb") return a.defaultProb - b.defaultProb;
      if (sortBy === "yieldAsk") return b.yieldAsk - a.yieldAsk;
      return 0;
    });
  }, [scored, sortBy, filterRating]);

  const displayed = filtered.slice(0, showTop);
  const top = filtered[0];

  const getScoreColor = (score) => {
    if (score >= 65) return "#00e5a0";
    if (score >= 50) return "#f5c518";
    if (score >= 35) return "#ff8c42";
    return "#ff4444";
  };

  const getBarWidth = (val, max) => `${Math.max(2, (val / max) * 100)}%`;

  return (
    <div style={{ fontFamily: "'IBM Plex Mono', 'Courier New', monospace", background: "#0a0e1a", minHeight: "100vh", color: "#c8d6e5", padding: "0" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@300;400;600&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; }
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: #0a0e1a; }
        ::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 2px; }
        input[type=range] { -webkit-appearance: none; height: 3px; border-radius: 2px; outline: none; cursor: pointer; }
        input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%; background: #00e5a0; cursor: pointer; }
        .bond-row:hover { background: #0d1829 !important; }
        .pill { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 10px; font-weight: 600; letter-spacing: 0.05em; }
        .tag-bbb { background: #1a3a2a; color: #00e5a0; border: 1px solid #00e5a033; }
        .tag-bbp { background: #1a2a3a; color: #4db8ff; border: 1px solid #4db8ff33; }
        .tag-bb { background: #2a1a1a; color: #ff6b6b; border: 1px solid #ff6b6b33; }
        .rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; font-size: 10px; font-weight: 700; }
        .metric-bar { height: 3px; border-radius: 2px; background: #0d1829; overflow: hidden; }
        .metric-fill { height: 100%; border-radius: 2px; transition: width 0.3s; }
        .weight-row:hover { background: #0d1829; }
        select { background: #0d1829; color: #c8d6e5; border: 1px solid #1e3a5f; border-radius: 4px; padding: 4px 8px; font-family: inherit; font-size: 11px; cursor: pointer; outline: none; }
      `}</style>

      {/* Header */}
      <div style={{ background: "linear-gradient(135deg, #0d1829 0%, #0a1525 100%)", borderBottom: "1px solid #1e3a5f", padding: "20px 28px" }}>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "12px" }}>
          <div>
            <div style={{ fontSize: "10px", letterSpacing: "0.3em", color: "#4db8ff", marginBottom: "4px", textTransform: "uppercase" }}>Risk-Adjusted Bond Scorer</div>
            <div style={{ fontSize: "22px", fontWeight: "700", color: "#ffffff", letterSpacing: "-0.02em" }}>BB — BBB<span style={{ color: "#00e5a0" }}>-</span> Universe</div>
            <div style={{ fontSize: "11px", color: "#5a7a9a", marginTop: "4px" }}>{RAW_DATA.length} bonds · EUR denominated · Weighted composite scoring</div>
          </div>
          <div style={{ display: "flex", gap: "16px" }}>
            {["ALL", "BBB-", "BB+", "BB"].map(r => (
              <button key={r} onClick={() => setFilterRating(r)} style={{ background: filterRating === r ? "#1e3a5f" : "transparent", border: `1px solid ${filterRating === r ? "#4db8ff" : "#1e3a5f"}`, color: filterRating === r ? "#4db8ff" : "#5a7a9a", borderRadius: "4px", padding: "5px 14px", fontSize: "11px", fontFamily: "inherit", cursor: "pointer", fontWeight: filterRating === r ? "600" : "400", letterSpacing: "0.05em" }}>
                {r}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "300px 1fr", gap: "0", minHeight: "calc(100vh - 80px)" }}>

        {/* Left Panel - Weights */}
        <div style={{ background: "#0d1420", borderRight: "1px solid #1e3a5f", padding: "20px" }}>
          <div style={{ fontSize: "9px", letterSpacing: "0.3em", color: "#4db8ff", marginBottom: "16px", textTransform: "uppercase" }}>Scoring Weights</div>

          <div style={{ background: "#0a0e1a", border: "1px solid #1e3a5f", borderRadius: "6px", padding: "12px", marginBottom: "16px" }}>
            <div style={{ fontSize: "9px", color: "#5a7a9a", letterSpacing: "0.1em", marginBottom: "4px" }}>TOTAL WEIGHT ALLOCATED</div>
            <div style={{ fontSize: "24px", fontWeight: "700", color: totalWeight === 100 ? "#00e5a0" : "#ff6b6b" }}>{totalWeight}<span style={{ fontSize: "14px", color: "#5a7a9a" }}>/ 100</span></div>
            {totalWeight !== 100 && <div style={{ fontSize: "10px", color: "#ff6b6b", marginTop: "4px" }}>⚠ Weights should sum to 100</div>}
          </div>

          {Object.entries(METRIC_INFO).map(([key, info]) => (
            <div key={key} className="weight-row" style={{ padding: "10px 8px", borderRadius: "4px", marginBottom: "4px" }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "6px" }}>
                <div>
                  <div style={{ fontSize: "11px", color: "#c8d6e5", fontWeight: "500" }}>{info.label}</div>
                  <div style={{ fontSize: "9px", color: "#3a5a7a", marginTop: "1px" }}>{info.direction === "higher_better" ? "↑ higher = better" : "↓ lower = better"}</div>
                </div>
                <div style={{ fontSize: "16px", fontWeight: "700", color: "#4db8ff", minWidth: "36px", textAlign: "right" }}>{weights[key]}</div>
              </div>
              <input type="range" min="0" max="50" value={weights[key]}
                onChange={e => setWeights(w => ({ ...w, [key]: parseInt(e.target.value) }))}
                style={{ width: "100%", accentColor: "#4db8ff", background: `linear-gradient(to right, #1e3a5f ${weights[key] * 2}%, #0a0e1a ${weights[key] * 2}%)` }}
              />
              <div style={{ fontSize: "9px", color: "#3a5a7a", marginTop: "3px" }}>{info.description}</div>
            </div>
          ))}

          <button onClick={() => setWeights(DEFAULT_WEIGHTS)} style={{ width: "100%", marginTop: "12px", background: "transparent", border: "1px solid #1e3a5f", color: "#5a7a9a", borderRadius: "4px", padding: "8px", fontSize: "10px", fontFamily: "inherit", cursor: "pointer", letterSpacing: "0.1em" }}>
            RESET TO DEFAULT
          </button>

          {/* Formula Box */}
          <div style={{ marginTop: "20px", background: "#0a0e1a", border: "1px solid #1e3a5f", borderRadius: "6px", padding: "12px" }}>
            <div style={{ fontSize: "9px", letterSpacing: "0.2em", color: "#4db8ff", marginBottom: "8px" }}>SCORING FORMULA</div>
            <div style={{ fontSize: "9px", color: "#5a7a9a", lineHeight: "1.8" }}>
              <div style={{ color: "#00e5a0", marginBottom: "4px" }}>Score = Σ (wᵢ × Nᵢ)</div>
              {Object.entries(METRIC_INFO).map(([key, info]) => (
                <div key={key}>w<sub>{key.slice(0,3)}</sub> = {weights[key]}% · N({info.label.split(" ")[0]})</div>
              ))}
              <div style={{ marginTop: "6px", color: "#3a5a7a" }}>Nᵢ = min-max normalized [0,1]<br />Direction-adjusted per metric</div>
            </div>
          </div>
        </div>

        {/* Right Panel - Results */}
        <div style={{ padding: "20px", overflowX: "auto" }}>

          {/* Top Pick Card */}
          {top && (
            <div style={{ background: "linear-gradient(135deg, #0d2218 0%, #0a1a14 100%)", border: "1px solid #00e5a044", borderRadius: "8px", padding: "16px 20px", marginBottom: "20px", display: "flex", gap: "24px", flexWrap: "wrap", alignItems: "center" }}>
              <div>
                <div style={{ fontSize: "9px", letterSpacing: "0.3em", color: "#00e5a0", marginBottom: "4px" }}>🏆 TOP RISK-ADJUSTED PICK</div>
                <div style={{ fontSize: "18px", fontWeight: "700", color: "#ffffff" }}>{top.issuer}</div>
                <div style={{ fontSize: "11px", color: "#5a7a9a", marginTop: "2px" }}>{top.isin} · {top.industry}</div>
              </div>
              <div style={{ display: "flex", gap: "20px", flexWrap: "wrap" }}>
                {[
                  { l: "Score", v: top.score.toFixed(1), unit: "/100", color: "#00e5a0" },
                  { l: "Yield", v: top.yieldAsk.toFixed(3), unit: "%", color: "#4db8ff" },
                  { l: "G-Spread", v: top.gSpread.toFixed(0), unit: "bps", color: "#f5c518" },
                  { l: "Net Debt/EBITDA", v: top.netDebtEbitda.toFixed(2), unit: "x", color: "#c8d6e5" },
                  { l: "Default Prob", v: top.defaultProb.toFixed(4), unit: "%", color: "#ff8c42" },
                ].map(({ l, v, unit, color }) => (
                  <div key={l} style={{ textAlign: "center" }}>
                    <div style={{ fontSize: "18px", fontWeight: "700", color }}>{v}<span style={{ fontSize: "11px", color: "#5a7a9a" }}>{unit}</span></div>
                    <div style={{ fontSize: "9px", color: "#3a5a7a", letterSpacing: "0.1em" }}>{l.toUpperCase()}</div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Controls */}
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "12px", flexWrap: "wrap", gap: "8px" }}>
            <div style={{ fontSize: "9px", color: "#5a7a9a", letterSpacing: "0.2em" }}>SHOWING {displayed.length} OF {filtered.length} BONDS</div>
            <div style={{ display: "flex", gap: "8px", alignItems: "center" }}>
              <span style={{ fontSize: "10px", color: "#5a7a9a" }}>SORT:</span>
              <select value={sortBy} onChange={e => setSortBy(e.target.value)}>
                <option value="score">Composite Score</option>
                <option value="gSpread">G-Spread</option>
                <option value="defaultProb">Default Prob</option>
                <option value="yieldAsk">Yield</option>
              </select>
              <span style={{ fontSize: "10px", color: "#5a7a9a" }}>SHOW:</span>
              <select value={showTop} onChange={e => setShowTop(parseInt(e.target.value))}>
                <option value={10}>Top 10</option>
                <option value={20}>Top 20</option>
                <option value={filtered.length}>All</option>
              </select>
            </div>
          </div>

          {/* Table */}
          <div style={{ overflowX: "auto" }}>
            <table style={{ width: "100%", borderCollapse: "collapse", fontSize: "11px" }}>
              <thead>
                <tr style={{ background: "#0d1829", borderBottom: "1px solid #1e3a5f" }}>
                  {["#", "Issuer", "Rating", "Score", "G-Spread", "Yield", "Net Debt/EBITDA", "Int. Coverage", "Default Prob", "FCF/Debt", "Rank"].map(h => (
                    <th key={h} style={{ padding: "8px 10px", textAlign: "left", fontSize: "9px", color: "#3a5a7a", letterSpacing: "0.1em", fontWeight: "600", whiteSpace: "nowrap" }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {displayed.map((bond, idx) => {
                  const ratingClass = bond.rating === "BBB-" ? "tag-bbb" : bond.rating === "BB+" ? "tag-bbp" : "tag-bb";
                  const scoreColor = getScoreColor(bond.score);
                  const rankBg = idx === 0 ? "#1a3a1a" : idx === 1 ? "#1a2a3a" : idx === 2 ? "#2a1a0a" : "#0d1829";
                  const rankColor = idx === 0 ? "#00e5a0" : idx === 1 ? "#c0c0c0" : idx === 2 ? "#cd7f32" : "#3a5a7a";

                  return (
                    <tr key={bond.isin} className="bond-row" style={{ borderBottom: "1px solid #0d1829", background: idx % 2 === 0 ? "#0a0e1a" : "#0c1220", cursor: "default" }}>
                      <td style={{ padding: "9px 10px" }}>
                        <span className="rank-badge" style={{ background: rankBg, color: rankColor }}>{idx + 1}</span>
                      </td>
                      <td style={{ padding: "9px 10px", maxWidth: "180px" }}>
                        <div style={{ fontWeight: "500", color: "#c8d6e5", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{bond.issuer}</div>
                        <div style={{ fontSize: "9px", color: "#3a5a7a", marginTop: "1px" }}>{bond.isin}</div>
                      </td>
                      <td style={{ padding: "9px 10px" }}><span className={`pill ${ratingClass}`}>{bond.rating}</span></td>
                      <td style={{ padding: "9px 10px" }}>
                        <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
                          <span style={{ fontWeight: "700", color: scoreColor, fontSize: "13px" }}>{bond.score.toFixed(1)}</span>
                          <div style={{ width: "50px" }}>
                            <div className="metric-bar"><div className="metric-fill" style={{ width: `${bond.score}%`, background: scoreColor }} /></div>
                          </div>
                        </div>
                      </td>
                      <td style={{ padding: "9px 10px", color: "#f5c518", fontWeight: "500" }}>{bond.gSpread.toFixed(0)}<span style={{ fontSize: "9px", color: "#5a7a9a" }}>bp</span></td>
                      <td style={{ padding: "9px 10px", color: "#4db8ff" }}>{bond.yieldAsk.toFixed(3)}<span style={{ fontSize: "9px", color: "#5a7a9a" }}>%</span></td>
                      <td style={{ padding: "9px 10px", color: bond.netDebtEbitda > 5 ? "#ff6b6b" : bond.netDebtEbitda > 3 ? "#f5c518" : "#00e5a0" }}>{bond.netDebtEbitda.toFixed(2)}x</td>
                      <td style={{ padding: "9px 10px", color: bond.interestCoverage === null ? "#3a5a7a" : bond.interestCoverage < 2 ? "#ff6b6b" : bond.interestCoverage < 4 ? "#f5c518" : "#00e5a0" }}>{bond.interestCoverage !== null ? bond.interestCoverage.toFixed(2) + "x" : "—"}</td>
                      <td style={{ padding: "9px 10px", color: bond.defaultProb > 1 ? "#ff6b6b" : bond.defaultProb > 0.5 ? "#f5c518" : "#00e5a0" }}>{bond.defaultProb.toFixed(4)}<span style={{ fontSize: "9px", color: "#5a7a9a" }}>%</span></td>
                      <td style={{ padding: "9px 10px", color: bond.fcfDebt === null ? "#3a5a7a" : bond.fcfDebt < 0 ? "#ff6b6b" : "#00e5a0" }}>{bond.fcfDebt !== null ? (bond.fcfDebt * 100).toFixed(1) + "%" : "—"}</td>
                      <td style={{ padding: "9px 10px" }}><span style={{ fontSize: "9px", color: "#5a7a9a", whiteSpace: "nowrap" }}>{bond.paymentRank}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          {/* Legend */}
          <div style={{ marginTop: "16px", display: "flex", gap: "16px", flexWrap: "wrap" }}>
            {[{ color: "#00e5a0", label: "Score ≥ 65 (Strong)" }, { color: "#f5c518", label: "Score 50–65 (Moderate)" }, { color: "#ff8c42", label: "Score 35–50 (Weak)" }, { color: "#ff4444", label: "Score < 35 (Poor)" }].map(({ color, label }) => (
              <div key={label} style={{ display: "flex", alignItems: "center", gap: "6px" }}>
                <div style={{ width: "8px", height: "8px", borderRadius: "50%", background: color }} />
                <span style={{ fontSize: "9px", color: "#5a7a9a" }}>{label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}
